[
  "xcodebuild",
  "test",
  "-project",
  "Planner.xcodeproj",
  "-scheme",
  "Planner",
  "-destination",
  "platform=macOS,arch=arm64",
  "-derivedDataPath",
  "/private/tmp/PlannerMapNativeDerivedData",
  "-clonedSourcePackagesDirPath",
  "/private/tmp/PlannerCalendarMonthSourcePackages",
  "-disableAutomaticPackageResolution",
  "-parallel-testing-enabled",
  "NO",
  "-jobs",
  "1",
  "-only-testing:PlannerMCPTests/SavedMapCollectionTests/testNameOnlyLocationUsesFirstMapsLinkAndRetainsItsSearchUncertainty",
  "-only-testing:PlannerMCPTests/SavedMapCollectionTests/testAmbiguousAddressNeedsAnExactChoiceAndRejectsItAfterTheAddressChanges",
  "-only-testing:PlannerMCPTests/SavedMapCollectionTests/testMapWaitsForTheSameAddressAlreadyLoadingInDetails",
  "-only-testing:PlannerMCPTests/SavedMapCollectionTests/testCancelledProvidersKeepTheirSlotsUntilTheyActuallyFinish",
  "-only-testing:PlannerMCPTests/SavedMapCollectionTests/testUIDeadlineOffersRetryWithoutReleasingTheOccupiedProvider",
  "-only-testing:PlannerMCPTests/SavedMapCollectionTests/testAddressResolutionReusesDetailsCacheAndKeepsRepeatedAppearanceChoices",
  "-resultBundlePath",
  "/private/tmp/PlannerMapCollection-maps-link-green.xcresult",
  "CODE_SIGNING_ALLOWED=YES",
  "CODE_SIGN_IDENTITY=-",
  "CODE_SIGN_STYLE=Manual",
  "DEVELOPMENT_TEAM=",
  "ARCHS=arm64",
  "ONLY_ACTIVE_ARCH=YES"
]
