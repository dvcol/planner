[
  "xcodebuild",
  "build-for-testing",
  "-project",
  "Planner.xcodeproj",
  "-scheme",
  "PlannerNavigation",
  "-destination",
  "generic/platform=iOS Simulator",
  "-derivedDataPath",
  "/private/tmp/PlannerBrowserMobileDerivedData",
  "-clonedSourcePackagesDirPath",
  "/private/tmp/PlannerCalendarMonthSourcePackages",
  "-disableAutomaticPackageResolution",
  "-parallel-testing-enabled",
  "NO",
  "-jobs",
  "1",
  "CODE_SIGNING_ALLOWED=NO",
  "ARCHS=arm64",
  "ONLY_ACTIVE_ARCH=YES"
]
