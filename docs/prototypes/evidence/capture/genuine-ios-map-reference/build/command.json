[
  "xcodebuild",
  "build-for-testing",
  "-scheme",
  "PlannerCore",
  "-destination",
  "generic/platform=iOS Simulator",
  "-derivedDataPath",
  "/private/tmp/PlannerGenuineIOSCaptureDerivedData",
  "-disableAutomaticPackageResolution",
