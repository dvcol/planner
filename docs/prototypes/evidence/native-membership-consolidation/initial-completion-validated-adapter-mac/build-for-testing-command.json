[
  "xcodebuild",
  "build-for-testing",
  "-project",
  "Planner.xcodeproj",
  "-scheme",
  "Planner",
  "-destination",
  "platform=macOS,arch=arm64",
  "-derivedDataPath",
  "/private/tmp/PlannerMapNativeDerivedData",
  "-clonedSourcePackagesDirPath",
  "/private/tmp/PlannerItinerarySelectionSourcePackages",
  "-disableAutomaticPackageResolution",
  "-parallel-testing-enabled",
  "NO",
  "-jobs",
  "1",
  "-only-testing:PlannerMCPTests/MembershipCreationRoutingTests",
  "-only-testing:PlannerMCPTests/MembershipMutationRoutingTests",
  "-only-testing:PlannerMCPTests/NativeStatusBoundaryTests",
  "-only-testing:PlannerMCPTests/BulkCompletionRoutingTests",
  "CODE_SIGNING_ALLOWED=YES",
  "CODE_SIGN_IDENTITY=-",
  "CODE_SIGN_STYLE=Manual",
  "DEVELOPMENT_TEAM=",
  "ARCHS=arm64",
  "ONLY_ACTIVE_ARCH=YES",
  "-resultBundlePath",
  "/private/tmp/PlannerMembershipAdapter-initial-completion-validated-adapter-mac-build-for-testing.xcresult"
]
