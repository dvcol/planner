[
  "xcodebuild",
  "-project",
  "Planner.xcodeproj",
  "-scheme",
  "Planner",
  "-destination",
  "platform=macOS,arch=arm64",
  "-derivedDataPath",
  "/private/tmp/PlannerQ93HTTPDerivedData",
  "-clonedSourcePackagesDirPath",
  "/private/tmp/PlannerMCPSourcePackages",
  "-disableAutomaticPackageResolution",
  "-parallel-testing-enabled",
  "NO",
  "-jobs",
  "1",
  "-only-testing:PlannerMCPTests/ItemInListCreationRoutingTests",
  "-only-testing:PlannerMCPTests/ItemLabelAdmissionTests",
  "-only-testing:PlannerMCPTests/ItemLabelRoutingTests",
  "-only-testing:PlannerMCPTests/MembershipCreationRoutingTests",
  "-only-testing:PlannerMCPTests/CaptureRoutingTests",
  "-resultBundlePath",
  "/private/tmp/PlannerQ93HTTP-http-compatibility-qualified.xcresult",
  "CODE_SIGNING_ALLOWED=NO",
  "test"
]
