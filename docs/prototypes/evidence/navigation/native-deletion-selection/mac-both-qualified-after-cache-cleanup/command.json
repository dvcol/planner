[
  "xcodebuild",
  "test",
  "-project",
  "Planner.xcodeproj",
  "-scheme",
  "PlannerNavigation",
  "-destination",
  "platform=macOS,arch=arm64",
  "-derivedDataPath",
  "/private/tmp/PlannerRetainedRecoveryMacDerivedData",
  "-clonedSourcePackagesDirPath",
  "/private/tmp/PlannerCalendarMonthSourcePackages",
  "-disableAutomaticPackageResolution",
  "-parallel-testing-enabled",
  "NO",
  "-jobs",
  "1",
  "-test-timeouts-enabled",
  "YES",
  "-default-test-execution-time-allowance",
  "300",
  "-maximum-test-execution-time-allowance",
  "300",
  "-only-testing:PlannerNavigationUITests/SavedAppearanceJourneyTests/testDeletingSelectedItemChoosesTheFirstVisibleSurvivorInTheCurrentSort",
  "-resultBundlePath",
  "/private/tmp/PlannerDeletionSelection-mac-both-qualified-after-cache-cleanup.xcresult",
  "-only-testing:PlannerNavigationUITests/SavedAppearanceJourneyTests/testDeletingSelectedListChoosesTheFirstVisibleListAndItsFirstItemOnRegularLayouts",
  "-only-testing:PlannerNavigationUITests/SavedAppearanceJourneyTests/testDeletingASelectedAppearanceInAnotherWindowSelectsItsFirstVisibleSibling"
]
