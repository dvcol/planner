[
  "xcodebuild",
  "test",
  "-project",
  "Planner.xcodeproj",
  "-scheme",
  "Planner",
  "-destination",
  "platform=macOS,arch=arm64",
  "-derivedDataPath",
  "/private/tmp/PlannerNativeItemWindowDerivedData",
  "-clonedSourcePackagesDirPath",
  "/private/tmp/PlannerCalendarMonthSourcePackages",
  "-disableAutomaticPackageResolution",
  "-parallel-testing-enabled",
  "NO",
  "-jobs",
  "1",
  "-only-testing:PlannerMCPTests/PlannerItineraryEntryIntentTests",
  "-only-testing:PlannerMCPTests/PlannerItineraryItemIntentTests",
  "-only-testing:PlannerMCPTests/PlannerCategoryIntentTests",
  "-only-testing:PlannerMCPTests/PlannerListReorderIntentTests",
  "-only-testing:PlannerMCPTests/PlannerListCompletionIntentTests",
  "-only-testing:PlannerMCPTests/PlannerListOrganizationIntentTests",
  "-only-testing:PlannerMCPTests/PlannerItineraryOrganizationIntentTests",
  "-only-testing:PlannerMCPTests/PlannerItineraryEditingIntentTests",
  "-only-testing:PlannerMCPTests/PlannerItineraryIntentTests",
  "-only-testing:PlannerMCPTests/PlannerListEditingIntentTests",
  "-only-testing:PlannerMCPTests/PlannerListIntentTests",
  "-only-testing:PlannerMCPTests/PlannerItemIntentTests",
  "-resultBundlePath",
  "/private/tmp/PlannerItemWindow-app-intent-itinerary-entry-final-qualification.xcresult",
  "CODE_SIGNING_ALLOWED=YES",
  "CODE_SIGN_IDENTITY=-",
  "CODE_SIGN_STYLE=Manual",
  "DEVELOPMENT_TEAM=",
  "ARCHS=arm64",
  "ONLY_ACTIVE_ARCH=YES"
]
