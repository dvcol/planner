[
  "xcodebuild",
  "test",
  "-project",
  "Planner.xcodeproj",
  "-scheme",
  "Planner",
  "-destination",
  "platform=macOS,arch=arm64",
  "-derivedDataPath",
  "/private/tmp/PlannerNativeItemWindowDerivedData",
  "-clonedSourcePackagesDirPath",
  "/private/tmp/PlannerCalendarMonthSourcePackages",
  "-disableAutomaticPackageResolution",
  "-parallel-testing-enabled",
  "NO",
  "-jobs",
  "1",
  "-only-testing:PlannerMCPTests/PlannerLinkRemovalIntentTests",
  "-only-testing:PlannerMCPTests/PlannerLinkReorderIntentTests",
  "-only-testing:PlannerMCPTests/PlannerRetainedLinkIntentTests",
  "-only-testing:PlannerMCPTests/PlannerLinkIntentTests",
  "-only-testing:PlannerMCPTests/PlannerOwnedLocationIntentTests",
  "-only-testing:PlannerMCPTests/PlannerItemIntentTests",
  "-only-testing:PlannerMCPTests/PlannerItineraryEditingIntentTests",
  "-only-testing:PlannerMCPTests/ItineraryEditRoutingTests",
  "-only-testing:PlannerMCPTests/ItemInListCreationRoutingTests",
  "-only-testing:PlannerMCPTests/OperationStatusRoutingTests",
  "-resultBundlePath",
  "/private/tmp/PlannerItemWindow-app-intent-link-mutations-final-qualified.xcresult",
  "CODE_SIGNING_ALLOWED=YES",
  "CODE_SIGN_IDENTITY=-",
  "CODE_SIGN_STYLE=Manual",
  "DEVELOPMENT_TEAM=",
  "ARCHS=arm64",
  "ONLY_ACTIVE_ARCH=YES"
]
