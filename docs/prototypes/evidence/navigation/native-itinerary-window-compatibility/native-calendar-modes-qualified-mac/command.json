[
  "xcodebuild",
  "test-without-building",
  "-project",
  "Planner.xcodeproj",
  "-scheme",
  "PlannerNavigation",
  "-destination",
  "platform=macOS,arch=arm64",
  "-derivedDataPath",
  "/private/tmp/PlannerNativeItemWindowDerivedData",
  "-parallel-testing-enabled",
  "NO",
  "-jobs",
  "1",
  "-test-timeouts-enabled",
  "YES",
  "-default-test-execution-time-allowance",
  "300",
  "-maximum-test-execution-time-allowance",
  "300",
  "-only-testing:PlannerNavigationUITests/SavedCalendarModesJourneyTests/testDenseAllDaySchedulesKeepTimedAppointmentsAndEveryScheduleAccessible",
  "-only-testing:PlannerNavigationUITests/SavedCalendarModesJourneyTests/testSimultaneousStartOnlyAppointmentsRemainSeparateAndUsableInDayView",
  "-only-testing:PlannerNavigationUITests/SavedCalendarModesJourneyTests/testDayAndWeekShowTheSavedStartOnlyEntryWithoutReschedulingIt",
  "-resultBundlePath",
  "/private/tmp/PlannerItemWindow-native-calendar-modes-qualified-mac.xcresult"
]
