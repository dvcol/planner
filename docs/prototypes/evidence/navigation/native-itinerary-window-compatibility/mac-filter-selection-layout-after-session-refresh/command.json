[
  "xcodebuild",
  "test",
  "-project",
  "Planner.xcodeproj",
  "-scheme",
  "PlannerNavigation",
  "-destination",
  "platform=macOS,arch=arm64",
  "-derivedDataPath",
  "/private/tmp/PlannerNativeItemWindowDerivedData",
  "-clonedSourcePackagesDirPath",
  "/private/tmp/PlannerCalendarMonthSourcePackages",
  "-disableAutomaticPackageResolution",
  "-parallel-testing-enabled",
  "NO",
  "-jobs",
  "1",
  "-only-testing:PlannerNavigationUITests/SavedAppearanceJourneyTests/testNativeUndoPreservesFiltersAndAnotherSelectedListAppearance",
  "-only-testing:PlannerNavigationUITests/SavedAppearanceJourneyTests/testNewItemDraftRetainsItsFieldsAndOriginalListThroughLayoutChanges",
  "-resultBundlePath",
  "/private/tmp/PlannerItemWindow-mac-filter-selection-layout-after-session-refresh.xcresult",
  "CODE_SIGNING_ALLOWED=YES",
  "CODE_SIGN_IDENTITY=-",
  "CODE_SIGN_STYLE=Manual",
  "DEVELOPMENT_TEAM=",
  "ARCHS=arm64",
  "ONLY_ACTIVE_ARCH=YES"
]
