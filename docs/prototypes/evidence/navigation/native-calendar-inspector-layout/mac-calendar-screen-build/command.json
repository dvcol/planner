[
  "xcodebuild",
  "build-for-testing",
  "-project",
  "Planner.xcodeproj",
  "-scheme",
  "PlannerNavigation",
  "-destination",
  "platform=macOS,arch=arm64",
  "-derivedDataPath",
  "/private/tmp/PlannerRetainedRecoveryMacDerivedData",
  "-clonedSourcePackagesDirPath",
  "/private/tmp/PlannerCalendarMonthSourcePackages",
  "-disableAutomaticPackageResolution",
  "-parallel-testing-enabled",
  "NO",
  "-jobs",
  "1",
  "-only-testing:PlannerNavigationUITests/SavedCalendarInspectorJourneyTests/testCalendarDetailsCanHideAndReopenWithoutChangingTheSelectedSchedule",
  "CODE_SIGNING_ALLOWED=YES",
  "ARCHS=arm64",
  "ONLY_ACTIVE_ARCH=YES",
  "CODE_SIGN_IDENTITY=-",
  "CODE_SIGN_STYLE=Manual",
  "DEVELOPMENT_TEAM="
]
