[
  "xcodebuild",
  "build",
  "-project",
  "Planner.xcodeproj",
  "-scheme",
  "Planner",
  "-destination",
  "generic/platform=iOS Simulator",
  "-derivedDataPath",
  "/private/tmp/PlannerShareProducts-mobile",
  "-clonedSourcePackagesDirPath",
  "/private/tmp/PlannerCalendarMonthSourcePackages",
  "-disableAutomaticPackageResolution",
  "-jobs",
  "1",
  "CODE_SIGNING_ALLOWED=NO",
  "ARCHS=arm64",
  "ONLY_ACTIVE_ARCH=YES"
]
