{
  "environment": {
    "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
  },
  "xcodebuild": {
    "fixture-mac-build.log.gz": [
      "/Applications/Xcode.app/Contents/Developer/usr/bin/xcodebuild",
      "build-for-testing",
      "-project",
      "Planner.xcodeproj",
      "-scheme",
      "PlannerFixtures",
      "-destination",
      "platform=macOS,arch=arm64",
      "-derivedDataPath",
      "/private/tmp/PlannerRetainedRecoveryMacDerivedData",
      "-clonedSourcePackagesDirPath",
      "/private/tmp/PlannerCalendarMonthSourcePackages",
      "-disableAutomaticPackageResolution",
      "-parallel-testing-enabled",
      "NO",
      "CODE_SIGNING_ALLOWED=NO"
    ],
    "phone/test.log.gz": [
      "/Applications/Xcode.app/Contents/Developer/usr/bin/xcodebuild",
      "test",
      "-project",
      "Planner.xcodeproj",
      "-scheme",
      "PlannerFixtures",
      "-destination",
      "platform=iOS Simulator,id=2A49C66C-C8A4-435F-B98A-9A90706780DE",
      "-derivedDataPath",
      "/private/tmp/PlannerCalendarTemporalDerivedData",
      "-clonedSourcePackagesDirPath",
      "/private/tmp/PlannerCalendarMonthSourcePackages",
      "-disableAutomaticPackageResolution",
      "-parallel-testing-enabled",
      "NO",
      "-only-testing:PlannerFixtureUITests/UnavailableStoreRecoveryJourneyTests",
      "-resultBundlePath",
      "/private/tmp/PlannerUnavailableExportPhone.xcresult",
      "CODE_SIGNING_ALLOWED=NO"
    ],
    "tablet/test.log.gz": [
      "/Applications/Xcode.app/Contents/Developer/usr/bin/xcodebuild",
      "test",
      "-project",
      "Planner.xcodeproj",
      "-scheme",
      "PlannerFixtures",
      "-destination",
      "platform=iOS Simulator,id=FBD72DAB-1D40-4E64-912D-7F9763E00446",
      "-derivedDataPath",
      "/private/tmp/PlannerCalendarTemporalDerivedData",
      "-clonedSourcePackagesDirPath",
      "/private/tmp/PlannerCalendarMonthSourcePackages",
      "-disableAutomaticPackageResolution",
      "-parallel-testing-enabled",
      "NO",
      "-only-testing:PlannerFixtureUITests/UnavailableStoreRecoveryJourneyTests",
      "-resultBundlePath",
      "/private/tmp/PlannerUnavailableExportTablet.xcresult",
      "CODE_SIGNING_ALLOWED=NO"
    ]
  },
  "resultExports": [
    "xcrun xcresulttool get test-results summary --path <bundle>",
    "xcrun xcresulttool get test-results tests --path <bundle>",
    "xcrun xcresulttool export attachments --path <bundle> --output-path <directory> --filter *.png",
    "xcrun xcresulttool export attachments --path <bundle> --output-path <directory> --filter *.txt"
  ],
  "deliveredFiles": [
    "python3 /private/tmp/PlannerUnavailableExportCheckFile.py phone",
    "python3 /private/tmp/PlannerUnavailableExportCheckFile.py tablet"
  ],
  "strictSwift": [
    "xcrun",
    "swift-format",
    "lint",
    "--strict",
    "PlannerFixtureUITests/UnavailableStoreRecoveryJourneyTests.swift"
  ],
  "markdown": [
    "pnpm",
    "dlx",
    "markdownlint-cli2",
    "--config",
    "docs/prototypes/evidence/navigation/native-empty-recovery-graph/markdownlint.jsonc",
    "docs/prototypes/native-unavailable-store-export.md"
  ]
}
