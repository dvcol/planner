          "operation": "appendCopy",
          "path": "/sources",
          "from": "/sources/0"
        }
      ],
      "mode": "skip",
      "expected": {
        "code": "invalidInput",
        "propertyPath": "/sources/7/id",
        "noMutation": true
      }
    },
