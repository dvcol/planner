    {
      "name": "Delete cancel preserves every owner and reference",
      "nativeCommand": {
        "type": "deleteSource",
        "source": {
          "kind": "tag",
          "id": "00000000-0000-4000-8000-000000000601"
        }
      },
      "cancelReview": true,
      "expected": {
        "sourceRetained": true,
        "retainedAssociationIds": [
          "00000000-0000-4000-8000-000000000651",
          "00000000-0000-4000-8000-000000000652"
        ],
        "noMutation": true
      }
    },
    {
      "name": "confirmed Tag Delete removes associations only",
      "nativeCommand": {
        "type": "deleteSource",
        "source": {
          "kind": "tag",
          "id": "00000000-0000-4000-8000-000000000601"
        }
      },
      "confirmReview": true,
      "expected": {
        "removedSourceIds": [
          "00000000-0000-4000-8000-000000000601"
        ],
        "removedAssociationIds": [
          "00000000-0000-4000-8000-000000000651",
          "00000000-0000-4000-8000-000000000652"
        ],
        "retainedCategoryId": "00000000-0000-4000-8000-000000000501",
        "itemCount": "2",
        "allCompletionAndSchedulesRetained": true
      }
