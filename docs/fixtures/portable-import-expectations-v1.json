    {
      "name": "unsupported version rejects together",
      "incomingEdits": [
        {
          "operation": "replace",
          "path": "/formatVersion",
          "value": 2
        }
      ],
      "mode": "skip",
      "expected": {
        "code": "unsupportedVersion",
        "propertyPath": "/formatVersion",
        "noMutation": true
      }
    },
    {
      "name": "unknown supported-version field rejects together",
      "incomingEdits": [
        {
          "operation": "add",
          "path": "/sources/0/unrecognized",
          "value": true
        }
      ],
      "mode": "overwrite",
      "expected": {
        "code": "unknownField",
        "propertyPath": "/sources/0/unrecognized",
        "noMutation": true
      }
    },
    {
