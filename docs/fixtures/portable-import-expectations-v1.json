  "lineageAndRecovery": [
    {
      "name": "older backup cannot undo retained deletion",
      "before": "Deletion marker closes Item D 199/lifetime 819",
      "action": "Restore the post-deletion backup, then Skip a pre-deletion backup with D",
      "expected": "D remains absent; old references remain absent; no automatic restoration"
    },
    {
      "name": "deleted dependency skips complete owner",
      "before": "X is deleted; incoming new Z and new List C references incoming X/Z",
      "action": "Apply valid incoming backup using Skip",
      "expected": "Z imported once; X stays deleted; whole C skipped and reported; no shortened C"
    },
    {
      "name": "concurrent approved restoration families",
      "before": "Deleted X lifetime 811; two reviewed restores create candidates lifetime 814 and 815 in one predecessor family",
      "action": "Deliver both candidates and independent Z in both orders, then Delete X and deliver a late losing candidate",
      "expected": "One visible X chooses lifetime 814 initially; Z and authorized references survive; predecessor refs stay suppressed; subsequent Delete keeps both candidates absent"
    },
    {
      "name": "delayed alias cannot reassert Done after explicit Reopen",
      "before": "Standalone X/A alias Done and another alias Todo consolidate once",
      "action": "Explicit Reopen, relaunch, deliver a previously unseen initial Done alias",
      "expected": "One context stays Todo; unrelated contexts unchanged; intentional itinerary repeats remain independent"
    },
    {
      "name": "prepared-only proposal is unverified",
      "before": "Prepared proposal survives, both committed-receipt sources missing",
      "action": "Reopen and inspect the original operation",
      "expected": "preparedUnverified with the surviving proposal identity, never rollback/success; fresh reviewed retry uses a new operation"
    },
    {
      "name": "postcommit archive failure and checkpoint retry",
      "before": "Complete import committed; independent recovery publication fails",
      "action": "Read status, attempt another domain write, retry only the known checkpoint",
      "expected": "Full import retained; appliedRecoveryIncomplete; further mutationBlocked; checkpoint completion changes no domain data and ends with appliedRecoveryComplete"
    },
    {
      "name": "account ownership separation",
      "before": "Old account A recovery with X; current account B has W",
      "action": "Inspect/export A, then cancel a reviewed restoration",
      "expected": "B still has W only; no automatic A upload; exported portable file excludes ownership/control/receipt/presentation state"
    },
    {
      "name": "independent recovery integrity",
      "before": "Acknowledged envelope with exact portable bytes and SHA-256 digest",
      "action": "Corrupt one payload byte or supply a mismatched ownership binding",
      "expected": "Controlled integrity/ownership failure; preserve previous good envelope; never claim Saved on this device for unverified data"
    },
    {
      "name": "missing reliable evidence is not rollback",
      "before": "No proposal or committed receipt survives; evidence reads succeed",
      "action": "Inspect the original operation",
      "expected": "noReliableEvidence; no knownUnapplied/success inference and no automatic replay"
    }
  ]
}
