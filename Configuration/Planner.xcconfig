#include "Base.xcconfig"

PRODUCT_NAME = Planner
PRODUCT_BUNDLE_IDENTIFIER = org.example.PlannerMCPPrototype
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
SDKROOT = auto
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO
ENABLE_APP_SANDBOX = YES
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Configuration/PlannerMacPrototype.entitlements
INFOPLIST_KEY_CFBundleDisplayName = Planner MCP prototype
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
LD_RUNPATH_SEARCH_PATHS[sdk=macosx*] = $(inherited) @executable_path/../Frameworks
#include? "Local.xcconfig"
